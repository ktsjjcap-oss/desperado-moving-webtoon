{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "desperado-moving-webtoon",
  "compatibility_date": "2026-09-07",
  "assets": {
    "directory": ".",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": [
      "/assets/seq01/master.mp4"
    ]
  },
  "main": "worker.mjs"
}
